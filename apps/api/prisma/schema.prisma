generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum Certificate {
  U
  UA7
  UA13
  UA16
  A
}

enum SeatCategory {
  CLASSIC
  PREMIUM
  RECLINER
}

enum ShowFormat {
  STANDARD
  THREE_D
  IMAX
}

enum ShowtimeStatus {
  SCHEDULED
  CANCELLED
}

enum ReservationStatus {
  HELD
  PAYMENT_PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  // Recorded on our side. The provider order may not exist yet.
  CREATED
  // Provider order exists, waiting on the customer.
  PENDING
  SUCCEEDED
  FAILED
  // Money was taken but the booking couldn't be confirmed.
  REFUND_PENDING
  REFUNDED
}

enum OutboxStatus {
  PENDING
  DONE
  FAILED
}

enum ShowSeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  // Stored lowercased so lookups don't depend on how it was typed.
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sessions     Session[]
  reservations Reservation[]
  payments     PaymentAttempt[]
  bookings     Booking[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the cookie token, so a DB leak doesn't leak live sessions.
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model City {
  id      String   @id @default(uuid(7)) @db.Uuid
  slug    String   @unique
  name    String
  state   String
  cinemas Cinema[]

  @@map("cities")
}

model Movie {
  id             String      @id @default(uuid(7)) @db.Uuid
  slug           String      @unique
  title          String
  synopsis       String
  runtimeMinutes Int         @map("runtime_minutes")
  languages      String[]
  genres         String[]
  certificate    Certificate
  releaseDate    DateTime    @map("release_date") @db.Date
  rating         Decimal?    @db.Decimal(3, 1)
  posterUrl      String?     @map("poster_url")
  trailerUrl     String?     @map("trailer_url")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  showtimes      Showtime[]

  @@index([releaseDate])
  @@map("movies")
}

model Cinema {
  id          String       @id @default(uuid(7)) @db.Uuid
  cityId      String       @map("city_id") @db.Uuid
  slug        String       @unique
  name        String
  address     String
  city        City         @relation(fields: [cityId], references: [id])
  auditoriums Auditorium[]

  @@index([cityId])
  @@map("cinemas")
}

model Auditorium {
  id        String     @id @default(uuid(7)) @db.Uuid
  cinemaId  String     @map("cinema_id") @db.Uuid
  name      String
  cinema    Cinema     @relation(fields: [cinemaId], references: [id])
  seats     Seat[]
  showtimes Showtime[]

  @@unique([cinemaId, name])
  @@map("auditoriums")
}

model Seat {
  id           String       @id @default(uuid(7)) @db.Uuid
  auditoriumId String       @map("auditorium_id") @db.Uuid
  rowLabel     String       @map("row_label")
  number       Int
  category     SeatCategory
  // Position on the layout grid. Gaps between positions are aisles.
  gridRow      Int          @map("grid_row")
  gridColumn   Int          @map("grid_column")
  auditorium   Auditorium   @relation(fields: [auditoriumId], references: [id], onDelete: Cascade)
  showSeats    ShowSeat[]
  reservations ReservationSeat[]
  bookings     BookingSeat[]

  @@unique([auditoriumId, rowLabel, number])
  @@unique([auditoriumId, gridRow, gridColumn])
  @@map("seats")
}

model Showtime {
  id           String          @id @default(uuid(7)) @db.Uuid
  movieId      String          @map("movie_id") @db.Uuid
  auditoriumId String          @map("auditorium_id") @db.Uuid
  startsAt     DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime        @map("ends_at") @db.Timestamptz(3)
  language     String
  format       ShowFormat      @default(STANDARD)
  status       ShowtimeStatus  @default(SCHEDULED)
  movie        Movie           @relation(fields: [movieId], references: [id])
  auditorium   Auditorium      @relation(fields: [auditoriumId], references: [id])
  prices       ShowtimePrice[]
  seats        ShowSeat[]
  reservations Reservation[]
  bookings     Booking[]

  @@index([movieId, startsAt])
  @@map("showtimes")
}

model ShowtimePrice {
  showtimeId String       @map("showtime_id") @db.Uuid
  category   SeatCategory
  pricePaise Int          @map("price_paise")
  showtime   Showtime     @relation(fields: [showtimeId], references: [id], onDelete: Cascade)

  @@id([showtimeId, category])
  @@map("showtime_prices")
}

// One row per seat per show. This is the row that gets locked when someone
// tries to hold a seat, so it has to exist before the show goes on sale.
model ShowSeat {
  showtimeId       String            @map("showtime_id") @db.Uuid
  seatId           String            @map("seat_id") @db.Uuid
  status           ShowSeatStatus    @default(AVAILABLE)
  // The reservation that currently owns this seat, if any.
  reservationId    String?           @map("reservation_id") @db.Uuid
  heldUntil        DateTime?         @map("held_until") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  showtime         Showtime          @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seat             Seat              @relation(fields: [seatId], references: [id])
  reservation      Reservation?      @relation(fields: [reservationId], references: [id])
  reservationSeats ReservationSeat[]
  bookingSeats     BookingSeat[]

  @@id([showtimeId, seatId])
  @@index([reservationId])
  @@map("show_seats")
}

model Reservation {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  showtimeId     String            @map("showtime_id") @db.Uuid
  status         ReservationStatus @default(HELD)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  subtotalPaise  Int               @map("subtotal_paise")
  idempotencyKey String?           @map("idempotency_key")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id])
  showtime       Showtime          @relation(fields: [showtimeId], references: [id])
  seats          ReservationSeat[]
  showSeats      ShowSeat[]
  payments       PaymentAttempt[]
  booking        Booking?

  @@unique([userId, idempotencyKey])
  @@index([status, expiresAt])
  @@map("reservations")
}

// The seats a reservation asked for, with the price at the time of the hold.
// Kept even after the hold ends, unlike show_seats.reservation_id.
model ReservationSeat {
  reservationId String       @map("reservation_id") @db.Uuid
  showtimeId    String       @map("showtime_id") @db.Uuid
  seatId        String       @map("seat_id") @db.Uuid
  category      SeatCategory
  pricePaise    Int          @map("price_paise")
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  showSeat      ShowSeat     @relation(fields: [showtimeId, seatId], references: [showtimeId, seatId])
  seat          Seat         @relation(fields: [seatId], references: [id])

  @@id([reservationId, seatId])
  @@map("reservation_seats")
}

model PaymentAttempt {
  id                String        @id @default(uuid(7)) @db.Uuid
  reservationId     String        @map("reservation_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  status            PaymentStatus @default(CREATED)
  subtotalPaise     Int           @map("subtotal_paise")
  feePaise          Int           @map("fee_paise")
  taxPaise          Int           @map("tax_paise")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR")
  providerOrderId   String?       @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  checkoutUrl       String?       @map("checkout_url")
  refundId          String?       @map("refund_id")
  failureReason     String?       @map("failure_reason")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  reservation       Reservation   @relation(fields: [reservationId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  booking           Booking?

  @@index([reservationId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

// Every webhook we've accepted, keyed by the provider's event id. Used to
// drop duplicate deliveries, and as a record of what the provider told us.
model PaymentEvent {
  id              String   @id @default(uuid(7)) @db.Uuid
  providerEventId String   @unique @map("provider_event_id")
  type            String
  payload         Json
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@map("payment_events")
}

model Booking {
  id               String         @id @default(uuid(7)) @db.Uuid
  // Short code shown to the customer and printed on the ticket.
  reference        String         @unique
  userId           String         @map("user_id") @db.Uuid
  showtimeId       String         @map("showtime_id") @db.Uuid
  reservationId    String         @unique @map("reservation_id") @db.Uuid
  paymentAttemptId String         @unique @map("payment_attempt_id") @db.Uuid
  subtotalPaise    Int            @map("subtotal_paise")
  feePaise         Int            @map("fee_paise")
  taxPaise         Int            @map("tax_paise")
  totalPaise       Int            @map("total_paise")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id])
  showtime         Showtime       @relation(fields: [showtimeId], references: [id])
  reservation      Reservation    @relation(fields: [reservationId], references: [id])
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id])
  seats            BookingSeat[]
  ticket           Ticket?

  @@index([userId, createdAt])
  @@map("bookings")
}

model BookingSeat {
  bookingId  String       @map("booking_id") @db.Uuid
  showtimeId String       @map("showtime_id") @db.Uuid
  seatId     String       @map("seat_id") @db.Uuid
  category   SeatCategory
  pricePaise Int          @map("price_paise")
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat   ShowSeat     @relation(fields: [showtimeId, seatId], references: [showtimeId, seatId])
  seat       Seat         @relation(fields: [seatId], references: [id])

  @@id([bookingId, seatId])
  // The last line of defence against selling a seat twice.
  @@unique([showtimeId, seatId])
  @@map("booking_seats")
}

model Ticket {
  id          String    @id @default(uuid(7)) @db.Uuid
  bookingId   String    @unique @map("booking_id") @db.Uuid
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(3)
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

// Work that has to happen after a transaction commits (refunds, emails).
// Written in the same transaction as the change that needs it, then picked
// up by the worker, so nothing is lost if the process dies in between.
model OutboxEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}
