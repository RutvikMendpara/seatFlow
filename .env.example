# Host ports. Postgres defaults to 5433 so it doesn't clash with a local install.
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000
PAYMENTS_PORT=4100

POSTGRES_USER=seatflow
POSTGRES_PASSWORD=seatflow
POSTGRES_DB=seatflow

# Shared between the API and the payment simulator. Test values only.
PAYMENT_API_KEY=sk_test_seatflow
PAYMENT_WEBHOOK_SECRET=whsec_test_seatflow
TICKET_SIGNING_SECRET=dev-only-ticket-signing-secret-change-me

# Staff account the seed creates, for ticket check-in. Dev only.
SEED_ADMIN_EMAIL=admin@seatflow.test
SEED_ADMIN_PASSWORD=change-me-admin-password
